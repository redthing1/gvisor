FROM docker.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

ARG BAZEL_VERSION

# Resolve build packages against a fixed, signed Debian snapshot.
RUN rm -f /etc/apt/sources.list.d/debian.sources && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261012T000000Z bookworm main\n' > /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl g++ git make patch python3 unzip zip xz-utils && \
    rm -rf /var/lib/apt/lists/*

COPY bazel.sha256 /tmp/bazel.sha256
RUN set -eu; \
    case "$(uname -m)" in x86_64) arch=x86_64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac; \
    cd /tmp; \
    curl -fSL --retry 3 "https://releases.bazel.build/${BAZEL_VERSION}/release/bazel-${BAZEL_VERSION}-linux-${arch}" -o "bazel-${BAZEL_VERSION}-linux-${arch}"; \
    sha256sum --check --ignore-missing bazel.sha256; \
    install -m 0755 "bazel-${BAZEL_VERSION}-linux-${arch}" /usr/local/bin/bazel; \
    rm bazel-* bazel.sha256

# Native code generation needs both architectures' C++ toolchains and BPF.
RUN set -eu; \
    case "$(uname -m)" in \
        x86_64) cross='g++-aarch64-linux-gnu libc6-dev-arm64-cross' ;; \
        aarch64) cross='g++-x86-64-linux-gnu libc6-dev-amd64-cross' ;; \
        *) exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends clang libbpf-dev $cross; \
    rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 builder
USER builder
WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "/workspace/mim/build-in-container"]
